  // This is your Prisma schema file,
  // learn more about it in the docs: https://pris.ly/d/prisma-schema

  // Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
  // Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

  generator client {
    provider = "prisma-client"
    output   = "../src/generated/prisma"
  }

  datasource db {
    provider = "postgresql"

  }


  enum AuthProviderType {
    GOOGLE
    CREDENTIAL
  }

  enum SocialPlatforms {
    LINKEDIN
    X
    FACEBOOK
    NONE
  }

  enum PostStatus {
    CREATED
    SCHEDULED
    UPLOADED
    PUBLISHED
    PENDING
    DARFT 
    FAILED
  }
  enum Provieder {
    X
    LINKEDIN
  }

  enum PlatfromPostStatus {
    PENDING
    POSTED
    FAILED
  }
  
  enum JobType {
    PUBLISH_POST
    SCHEDULE_POST
  }

  enum JobStatus {
    COMPLETED
    FAILED
  }

  model User {
    id  String @id @default(cuid()) @unique
    name String
    email String @unique
    password String?
    provider_id String?
    provider AuthProviderType
    profile_picture String?
    refresh_token String?
    createdAt DateTime @default(now())
    updatedAt DateTime  @updatedAt()

    // Relations

    connected_accounts SocialAccount[]
    posts Post[]
    platform_post PlatformPost[]
    Auth_sessions OAuthSession[]
    user_job job[]
  }

  model SocialAccount {
    id String @id @default(cuid())
    owner_id String 
    platform  SocialPlatforms
    platform_userid String
    username String?
    display_name String?
    profile_picture String?
    access_token String
    refresh_token String?
    token_expiry DateTime
    platformData Json? @default("{}")
    isActive Boolean @default(true)
    lastSync DateTime
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt()
    isExpired Boolean @default(false)

    // relation
    owner User @relation(fields:[owner_id], references:[id], onDelete:Cascade)
    platform_post PlatformPost[]
    post_analytics PostAnalytic[]


    @@index([owner_id])
    @@index([platform])
  }

  model Post {
    id String @id @default(cuid())
    owner_id String
    content String?
    mediaUrl String?
    mediaType String?
    status PostStatus
    scheduled_for SocialPlatforms[]
    scheduledAt DateTime?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt()

    owner User @relation(fields:[owner_id], references:[id], onDelete:Cascade)
    platform_post PlatformPost[]
    related_job job[]
      @@index([owner_id, status])
  }

  model PlatformPost {
    id String @id @default(cuid())
    post_id String 
    owner_id String 
    account_id String
    platform SocialPlatforms
    platform_post_id String?
    platform_post_url String?
    error String?
    status PlatfromPostStatus
    postedAt DateTime?
    failedAt DateTime?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt()

    post Post @relation(fields:[post_id], references:[id], onDelete:Cascade)
    owner User @relation(fields:[owner_id], references:[id], onDelete:Cascade)
    socialAccount SocialAccount @relation(fields: [account_id], references: [id], onDelete: Cascade)
    analytics PostAnalytic[]

    @@index([post_id, platform])
  }

  model OAuthSession {

    id            String   @id @default(cuid())
    ownerid       String 
    provider      SocialPlatforms
    state         String   @unique
    codeVerifier  String?   // PKCE code_verifier
    used          Boolean  @default(false)
    createdAt     DateTime @default(now())
    expiresAt     DateTime @default(dbgenerated("NOW() + INTERVAL '10 MINUTES'"))

    owner         User     @relation(fields: [ownerid], references: [id], onDelete: Cascade)

    @@index([ownerid])
    @@index([state])
  }

  model PostAnalytic {
    id String @id @default(cuid())
    account_id String
    platform_post_id String
    platform SocialPlatforms
    likes Int
    comments Int
    reach Float
    views Int
    members_added Int
    reshares Int
    timestamp DateTime @default(now())

    platform_post PlatformPost @relation(fields: [platform_post_id], references: [id], onDelete: Cascade)
    socialAccount SocialAccount @relation(fields: [account_id], references: [id], onDelete: Cascade)
  }

  model job {
    id String @id @default(cuid())
    owner_id String 
    job_type JobType
    related_post_id String
    platforms SocialPlatforms[]
    status JobStatus
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt()

    // relations 

    owner User @relation(fields: [owner_id], references: [id], onDelete: Cascade)
    related_post Post @relation(fields: [related_post_id], references: [id], onDelete: Cascade)

    @@index([owner_id, job_type, status])
  }

  



  
